<Window x:Class="DigitalGardener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Digital Gardener" Height="850" Width="1400"
        Icon="app.ico"
        Background="#14141A"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeWindowBg" Color="#14141A"/>
        <SolidColorBrush x:Key="ThemePanelBg" Color="#1E1E28"/>
        <SolidColorBrush x:Key="ThemeItemBg" Color="#282838"/>
        <SolidColorBrush x:Key="ThemeHoverBg" Color="#323246"/>
        <SolidColorBrush x:Key="ThemeMainText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSubText" Color="#B4B4BE"/>
        <SolidColorBrush x:Key="ThemeAccent" Color="#007ACC"/>
        <SolidColorBrush x:Key="ThemeBorder" Color="#3C3C50"/>
        <SolidColorBrush x:Key="ThemeGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="ThemeRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="ThemeWarning" Color="#F59E0B"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccent}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource ThemeItemBg}"
                                                BorderBrush="{StaticResource ThemeBorder}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource ThemeMainText}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,4,24,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{StaticResource ThemeMainText}"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="{StaticResource ThemeItemBg}">
                                    <Border Background="{StaticResource ThemeItemBg}"
                                            BorderBrush="{StaticResource ThemeAccent}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer Background="{StaticResource ThemeItemBg}">
                                            <StackPanel IsItemsHost="True"
                                                        Background="{StaticResource ThemeItemBg}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeSubText}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ThemeWindowBg}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CheckBoxCellTemplate">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="NameWithIconTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{StaticResource ThemeMainText}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccent}"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== ШАПКА ========== -->
        <Border Grid.Row="0" Background="{StaticResource ThemePanelBg}"
                Padding="16,12" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Digital Gardener" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ThemeMainText}" Margin="0,0,24,0"/>
                    <TextBlock Text="Панель управления очисткой и оптимизацией системы"
                               Foreground="{StaticResource ThemeSubText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⚙️ Настройки" Click="OpenSettings_Click"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="🔄 Проверить обновления" Click="CheckUpdates_Click"/>
            </Grid>
        </Border>

        <!-- ========== КРАСНАЯ ПЛАШКА (если нет админа) ========== -->
        <Border Grid.Row="1" x:Name="AdminWarningPanel" Visibility="Collapsed"
                Background="#7F1D1D" Padding="12,8"
                BorderBrush="{StaticResource ThemeRed}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Приложение запущено без прав администратора. Часть функций может быть недоступна (автозагрузка HKLM, системные процессы)."
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Content="Перезапустить от админа" Click="RestartAsAdmin_Click"
                        Background="#DC2626" Margin="20,0,0,0" Padding="12,6"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="{StaticResource ThemeItemBg}"
                    BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0" Padding="12">

            <!-- ==================== TEMP ==================== -->
            <TabItem Header="Temp и Downloads">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать" Click="ScanTempAndDownloads_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="DeleteToRecycleBin_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveFile_Click" Margin="0,0,10,0"/>
                        <Button Content="Открыть архив" Click="OpenArchiveFolder_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllTemp_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TempSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TempSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TempExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="TempExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportTempCsv_Click" Margin="0,0,10,0"/>
                        <Button Content="Показать скрытые" Click="ToggleHiddenFiles_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="TempDataGrid" ItemsSource="{Binding TempFiles}"
                              MouseDoubleClick="TempDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelected_Click"/>
                                <MenuItem Header="В корзину" Click="DeleteToRecycleBin_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveFile_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Дата доступа" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding TempSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== КЭШ БРАУЗЕРОВ ==================== -->
            <TabItem Header="Кэш браузеров">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать кэш" Click="ScanBrowserCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="RecycleSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllBrowser_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="BrowserSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="BrowserSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="BrowserExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="BrowserExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportBrowserCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="BrowserDataGrid" ItemsSource="{Binding BrowserCacheFiles}"
                              MouseDoubleClick="BrowserDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelectedBrowser_Click"/>
                                <MenuItem Header="В корзину" Click="RecycleSelectedBrowser_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveSelectedBrowser_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Браузер" Binding="{Binding Reason}" Width="140"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding BrowserSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== ИГРОВОЙ КЭШ ==================== -->
            <TabItem Header="🎮 Игровой кэш">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать игровой кэш" Click="ScanGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить выбранные" Click="CleanSelectedGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить ВСЁ" Click="CleanAllGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllGameCache_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="GameSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="GameSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportGameCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="GameCacheDataGrid" ItemsSource="{Binding GameCacheItems}"
                              MouseDoubleClick="GameCacheDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Очистить выбранные" Click="CleanSelectedGameCache_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Файлов" Binding="{Binding Reason}" Width="100"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Изменён" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding GameCacheSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== НЕИСПОЛЬЗУЕМЫЕ ==================== -->
            <TabItem Header="Неиспользуемые файлы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Не использовались более:" Foreground="{StaticResource ThemeMainText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UnusedDaysCombo" Width="120" SelectedIndex="3" Margin="0,0,10,0"
                                  SelectionChanged="UnusedDaysCombo_SelectionChanged">
                            <ComboBoxItem Content="30 дней"/>
                            <ComboBoxItem Content="60 дней"/>
                            <ComboBoxItem Content="90 дней"/>
                            <ComboBoxItem Content="180 дней"/>
                        </ComboBox>
                        <Button Content="Сканировать" Click="ScanUnusedFiles_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="RecycleSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="Открыть архив" Click="OpenArchiveFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="UnusedSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="UnusedSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UnusedExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="UnusedExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportUnusedCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="UnusedDataGrid" ItemsSource="{Binding UnusedFiles}"
                              MouseDoubleClick="UnusedDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelectedUnused_Click"/>
                                <MenuItem Header="В корзину" Click="RecycleSelectedUnused_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveSelectedUnused_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Дата доступа" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Source}" Width="130"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding UnusedSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== ДУБЛИКАТЫ ==================== -->
            <TabItem Header="Поиск дубликатов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать на дубликаты" Click="ScanDuplicates_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить дубликаты" Click="DeleteDuplicateToRecycleBin_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать дубликаты" Click="ArchiveDuplicate_Click" Margin="0,0,10,0"/>
                        <Button Content="Открыть архив" Click="OpenArchiveFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DupSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="DupSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportDupCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="DuplicatesDataGrid" ItemsSource="{Binding DuplicateCandidates}"
                              MouseDoubleClick="DuplicatesDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить дубликаты" Click="DeleteDuplicateToRecycleBin_Click"/>
                                <MenuItem Header="Архивировать дубликаты" Click="ArchiveDuplicate_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="140"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding OriginalPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding DuplicatesSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== АВТОЗАГРУЗКА ==================== -->
            <TabItem Header="Автозагрузка">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить список" Click="LoadStartupItems_Click" Margin="0,0,10,0"/>
                        <Button Content="Отключить выбранные" Click="DisableStartupItem_Click" Margin="0,0,10,0"/>
                        <Button Content="Оптимизировать автозагрузку" Click="OptimizeStartup_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StartupSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="StartupSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportStartupCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="StartupDataGrid" ItemsSource="{Binding StartupItems}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Отключить выбранные" Click="DisableStartupItem_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Расположение" Binding="{Binding Location}" Width="160"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="110"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding StartupSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== ПРОЦЕССЫ ==================== -->
            <TabItem Header="Мониторинг процессов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить процессы" Click="MonitorProcesses_Click" Margin="0,0,10,0"/>
                        <Button Content="Завершить выбранные" Click="KillProcess_Click" Margin="0,0,10,0"/>
                        <CheckBox x:Name="AutoRefreshProcessesCheck"
                                  Content="Авто-обновление"
                                  VerticalAlignment="Center" Margin="10,0,8,0"
                                  Foreground="{StaticResource ThemeMainText}"
                                  Checked="AutoRefreshProcesses_Changed"
                                  Unchecked="AutoRefreshProcesses_Changed"/>
                        <ComboBox x:Name="AutoRefreshIntervalCombo" Width="80"
                                  SelectionChanged="AutoRefreshInterval_Changed">
                            <ComboBoxItem Content="3 сек"/>
                            <ComboBoxItem Content="5 сек"/>
                            <ComboBoxItem Content="10 сек"/>
                            <ComboBoxItem Content="30 сек"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ProcSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ProcSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportProcCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ProcessesDataGrid" ItemsSource="{Binding RunningProcesses}"
                              MouseDoubleClick="ProcessesDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Завершить выбранные" Click="KillProcess_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя процесса" Binding="{Binding ProcessName}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Память" Binding="{Binding MemoryText}" Width="120"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding ProcessesSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== УДАЛЕНИЕ ПРОГРАММ ==================== -->
            <TabItem Header="🗑️ Удаление программ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить список" Click="LoadPrograms_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="UninstallPrograms_Click" Margin="0,0,10,0"/>
                        <TextBlock Text="Найдено:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="20,0,6,0"/>
                        <TextBlock x:Name="ProgramsCountText" Text="0"
                                   Foreground="{StaticResource ThemeMainText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ProgramsSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ProgramsSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportProgramsCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ProgramsDataGrid" ItemsSource="{Binding InstalledPrograms}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Удалить" Click="UninstallPrograms_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Версия" Binding="{Binding DisplayVersion}" Width="120"/>
                            <DataGridTextColumn Header="Издатель" Binding="{Binding Publisher}" Width="200"/>
                            <DataGridTextColumn Header="Установлена" Binding="{Binding InstallDate}" Width="120"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                               Text="Выберите программы и нажмите «Удалить выбранные». Откроется штатный деинсталлятор каждой программы."
                               Foreground="{StaticResource ThemeSubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ==================== ЗАБЛОКИРОВАННЫЕ ==================== -->
            <TabItem Header="Заблокированные файлы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить файл..." Click="AddLockedFile_Click" Margin="0,0,10,0"/>
                        <Button Content="Добавить папку..." Click="AddLockedFolder_Click" Margin="0,0,10,0"/>
                        <Button Content="Освободить (завершить процессы)" Click="UnlockSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить в корзину" Click="DeleteLockedFile_Click"/>
                        <Button Content="Выбрать все" Click="SelectAllLocked_Click" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="LockedSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="LockedSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportLockedCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="LockedDataGrid" ItemsSource="{Binding LockedFiles}"
                              MouseDoubleClick="LockedDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FilePath}" Width="2*"/>
                            <DataGridTextColumn Header="Кто блокирует" Binding="{Binding LockingProcesses}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding LockedSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ==================== ОС и ХАРАКТЕРИСТИКИ + ГРАФИКИ ==================== -->
            <TabItem Header="ОС и характеристики">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📊 Мониторинг в реальном времени:"
                                   Foreground="{StaticResource ThemeMainText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <CheckBox x:Name="ShowMonitorCheck"
                                  Content="Показывать"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource ThemeMainText}"
                                  Checked="ShowMonitor_Changed"
                                  Unchecked="ShowMonitor_Changed"/>
                        <TextBlock x:Name="CpuRamText"
                                   Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CPU (%)" Foreground="{StaticResource ThemeMainText}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <lvc:CartesianChart Height="180"
                                                    Series="{Binding CpuSeries}"
                                                    XAxes="{Binding CpuXAxes}"
                                                    YAxes="{Binding CpuYAxes}"
                                                    LegendPosition="Hidden"
                                                    TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM (%)" Foreground="{StaticResource ThemeMainText}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <lvc:CartesianChart Height="180"
                                                    Series="{Binding RamSeries}"
                                                    XAxes="{Binding RamXAxes}"
                                                    YAxes="{Binding RamYAxes}"
                                                    LegendPosition="Hidden"
                                                    TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="SystemInfoGrid" ItemsSource="{Binding SystemInfoItems}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== ПОМОЩЬ ==================== -->
            <TabItem Header="📖 Помощь">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="📖 Как пользоваться Digital Gardener"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}"
                                   Margin="0,0,0,20"/>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="⌨️ Горячие клавиши"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+A" FontWeight="Bold"/><Run Text=" — выбрать все элементы в текущей таблице"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Delete" FontWeight="Bold"/><Run Text=" — удалить выбранное (в корзину)"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="F5" FontWeight="Bold"/><Run Text=" — обновить текущую вкладку"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+E" FontWeight="Bold"/><Run Text=" — экспорт текущей таблицы в CSV"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Escape" FontWeight="Bold"/><Run Text=" — снять выделение"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+S" FontWeight="Bold"/><Run Text=" — открыть настройки"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="♻️ Восстановление удалённых файлов"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="Digital Gardener НЕ удаляет файлы безвозвратно. По умолчанию все удаления идут в "/>
                                    <Run Text="Корзину Windows" FontWeight="Bold"/>
                                    <Run Text=" — вы всегда можете восстановить файл через Проводник (Win+E → Корзина)."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🛡️ Права администратора"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="Приложение требует права администратора при запуске (UAC). Без них "/>
                                    <Run Text="некоторые функции будут недоступны" FontWeight="Bold"/>
                                    <Run Text=": отключение автозагрузки HKLM, завершение системных процессов, удаление системных файлов."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🖱️ Двойной клик ЛКМ по любой строке — откроет файл или папку в проводнике."
                                   Foreground="{StaticResource ThemeAccent}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="🗑️ Temp и Downloads" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Temp — временная папка Windows. Здесь программы хранят файлы «на минутку» (кэш установки, логи, промежуточные данные) и часто забывают их удалять. Со временем эта папка раздувается до гигабайт. Очистка Temp и Downloads безопасна: удаляются только мусорные файлы. Скачанные файлы в браузере (Downloads) приложение НЕ трогает."/>
                        </TextBlock>

                        <TextBlock Text="🌐 Кэш браузеров" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Когда вы заходите на сайт, браузер сохраняет картинки, скрипты и стили в кэш — чтобы в следующий раз сайт открылся быстрее. Со временем кэш занимает гигабайты. Очистка не затронет ваши пароли, закладки и историю — только временные данные."/>
                        </TextBlock>

                        <TextBlock Text="🎮 Игровой кэш" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Игры и видеокарты хранят shader cache — скомпилированные шейдеры для быстрой загрузки уровней. После обновления драйверов или самой игры этот кэш устаревает и занимает место. Очистка безопасна — игры создадут его заново."/>
                        </TextBlock>

                        <TextBlock Text="📁 Неиспользуемые файлы" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Приложение ищет файлы, папки и программы, которые вы не открывали дольше выбранного срока (30/60/90/180 дней). Это помогает освободить место. Перед удалением убедитесь, что файл вам действительно не нужен."/>
                        </TextBlock>

                        <TextBlock Text="🔍 Поиск дубликатов" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Приложение сравнивает файлы по хешу (уникальному «отпечатку») и находит идентичные копии. Это может освободить много места, если у вас много дубликатов фото, музыки или документов."/>
                        </TextBlock>

                        <TextBlock Text="🚀 Автозагрузка" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Программы, которые запускаются с Windows, замедляют старт системы. Приложение показывает всё, что в автозагрузке, и позволяет отключить лишнее. Отключение не удаляет программу — вы всегда можете вернуть её обратно."/>
                        </TextBlock>

                        <TextBlock Text="⚙️ Мониторинг процессов" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Показывает все запущенные процессы. Вы можете завершить «зависшие» или ненужные. Системные процессы (например, svchost) завершать не рекомендуется — это может нарушить работу Windows."/>
                        </TextBlock>

                        <TextBlock Text="🗑️ Удаление программ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Список всех установленных программ. При нажатии «Удалить» запускается штатный деинсталлятор программы — тот же, что и в Панели управления Windows."/>
                        </TextBlock>

                        <TextBlock Text="🔓 Заблокированные файлы" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Если файл не удаляется («занят другой программой»), приложение подскажет, какая программа держит файл, и поможет её завершить. Это самая полезная функция, если вам нужно срочно удалить занятый файл."/>
                        </TextBlock>

                        <TextBlock Text="📊 Графики CPU/RAM" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Показывают загрузку процессора и оперативной памяти в реальном времени. Если графики не нужны — снимите галочку «Показывать»."/>
                        </TextBlock>

                        <TextBlock Text="🔍 Поиск и фильтр" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Над каждой таблицей есть строка поиска и фильтр по расширению файлов. Это позволяет быстро найти нужный файл среди сотен и тысяч строк."/>
                        </TextBlock>

                        <TextBlock Text="⚙️ Настройки" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Кнопка «Настройки» в шапке — позволяет изменить: дни для поиска неиспользуемых файлов, авто-обновление процессов, интервал, показывать ли скрытые файлы, сворачивать ли в трей, закрывать ли в трей."/>
                        </TextBlock>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="💬 Связь с разработчиком"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}"
                                           TextWrapping="Wrap" Margin="0,0,0,12">
                                    <Run Text="Нашли баг? Есть идея? Хотите предложить функцию? Пишите в Telegram:"/>
                                </TextBlock>
                                <Button Content="✈️ @Boleznen — написать разработчику"
                                        Click="OpenTelegram_Click"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource ThemeAccent}"
                                        Padding="16,8"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="© 2026 Digital Gardener v1.2.0"
                                   Foreground="{StaticResource ThemeSubText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ЖУРНАЛ ==================== -->
            <TabItem Header="Журнал и Отчёт">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Обновить журнал ошибок" Click="RefreshLog_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить отчёт" Click="ClearReport_Click" Margin="0,0,10,0"/>
                        <Button Content="Экспорт в TXT" Click="ExportTxt_Click" Margin="0,0,10,0"/>
                        <Button Content="Экспорт в CSV" Click="ExportCsv_Click" Margin="0,0,10,0"/>
                        <Button Content="Открыть папку отчётов" Click="OpenReportsFolder_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить все отчёты" Click="DeleteAllReports_Click"/>
                    </WrapPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ReportItems}"
                             Background="{StaticResource ThemeItemBg}"
                             Foreground="{StaticResource ThemeMainText}"
                             BorderBrush="{StaticResource ThemeBorder}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="[" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="]" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource ThemeMainText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox Grid.Row="2" x:Name="LogTextBox" Height="130" Margin="0,12,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ========== ФУТЕР ========== -->
        <Border Grid.Row="3" Background="{StaticResource ThemePanelBg}"
                Padding="12" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding ProgressSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ThemeItemBg}"
                                    BorderBrush="{StaticResource ThemeBorder}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="8,4" Margin="0,0,8,0" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{StaticResource ThemeMainText}" FontSize="11"/>
                                    <ProgressBar Height="6" Margin="0,3,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent}"
                                                 Foreground="{StaticResource ThemeGreen}"
                                                 Background="{StaticResource ThemeWindowBg}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="1" x:Name="DiskSpaceText"
                           Text=""
                           Foreground="{StaticResource ThemeSubText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="2"
                           Text="Digital Gardener v1.2.0"
                           Foreground="{StaticResource ThemeSubText}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>