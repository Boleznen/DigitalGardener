<Window x:Class="DigitalGardener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Digital Gardener" Height="850" Width="1400"
        Icon="app.ico"
        Background="#14141A"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeWindowBg" Color="#14141A"/>
        <SolidColorBrush x:Key="ThemePanelBg" Color="#1E1E28"/>
        <SolidColorBrush x:Key="ThemeItemBg" Color="#282838"/>
        <SolidColorBrush x:Key="ThemeHoverBg" Color="#323246"/>
        <SolidColorBrush x:Key="ThemeMainText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSubText" Color="#B4B4BE"/>
        <SolidColorBrush x:Key="ThemeAccent" Color="#007ACC"/>
        <SolidColorBrush x:Key="ThemeBorder" Color="#3C3C50"/>
        <SolidColorBrush x:Key="ThemeGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="ThemeRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="ThemeWarning" Color="#F59E0B"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccent}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource ThemeItemBg}"
                                                BorderBrush="{StaticResource ThemeBorder}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource ThemeMainText}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,4,24,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{StaticResource ThemeMainText}"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="{StaticResource ThemeItemBg}">
                                    <Border Background="{StaticResource ThemeItemBg}"
                                            BorderBrush="{StaticResource ThemeAccent}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer Background="{StaticResource ThemeItemBg}">
                                            <StackPanel IsItemsHost="True" Background="{StaticResource ThemeItemBg}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeSubText}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ThemeWindowBg}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CheckBoxCellTemplate">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="NameWithIconTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{StaticResource ThemeMainText}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource ThemeItemBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeMainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccent}"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="{StaticResource ThemePanelBg}"
                Padding="16,12" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Digital Gardener" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ThemeMainText}" Margin="0,0,24,0"/>
                    <TextBlock Text="Панель управления очисткой и оптимизацией системы"
                               Foreground="{StaticResource ThemeSubText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="📂 Открыть архив" Click="OpenArchiveFolder_Click"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="🗑️ Открыть корзину" Click="OpenRecycleBin_Click"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="⚙️ Настройки" Click="OpenSettings_Click"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="4" Content="🔄 Проверить обновления" Click="CheckUpdates_Click"/>
            </Grid>
        </Border>

        <!-- ПЛАШКА "НЕТ АДМИНА" -->
        <Border Grid.Row="1" x:Name="AdminWarningPanel" Visibility="Collapsed"
                Background="#7F1D1D" Padding="12,8"
                BorderBrush="{StaticResource ThemeRed}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Приложение запущено без прав администратора. Часть функций может быть недоступна."
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Content="Перезапустить от админа" Click="RestartAsAdmin_Click"
                        Background="#DC2626" Margin="20,0,0,0" Padding="12,6"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="{StaticResource ThemeItemBg}"
                    BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0" Padding="12">

            <!-- TEMP -->
            <TabItem Header="Temp и Downloads">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать" Click="ScanTempAndDownloads_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="DeleteToRecycleBin_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveFile_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllTemp_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearTempList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TempSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TempSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TempExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="TempExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportTempCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="TempDataGrid" ItemsSource="{Binding TempFiles}"
                              MouseDoubleClick="TempDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelected_Click"/>
                                <MenuItem Header="В корзину" Click="DeleteToRecycleBin_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveFile_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Дата доступа" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TempSummary.Text}"
                                   Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold"/>
                        <TextBlock Text="ℹ️ Некоторые файлы могут не удалиться, если они сейчас используются (открыт браузер, Visual Studio и т.д.). Это нормально — они не будут удалены, но процесс продолжится."
                                   Foreground="{StaticResource ThemeWarning}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- КЭШ БРАУЗЕРОВ -->
            <TabItem Header="Кэш браузеров">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать кэш" Click="ScanBrowserCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="RecycleSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveSelectedBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllBrowser_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearBrowserList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="BrowserSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="BrowserSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="BrowserExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="BrowserExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportBrowserCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="BrowserDataGrid" ItemsSource="{Binding BrowserCacheFiles}"
                              MouseDoubleClick="BrowserDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelectedBrowser_Click"/>
                                <MenuItem Header="В корзину" Click="RecycleSelectedBrowser_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveSelectedBrowser_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Браузер" Binding="{Binding Reason}" Width="140"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding BrowserSummary.Text}"
                                   Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold"/>
                        <TextBlock Text="ℹ️ Некоторые файлы могут не удалиться, если браузер сейчас открыт. Закройте браузер перед очисткой кэша — файлы удалятся полностью."
                                   Foreground="{StaticResource ThemeWarning}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ИГРОВОЙ КЭШ -->
            <TabItem Header="🎮 Игровой кэш">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сканировать игровой кэш" Click="ScanGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить выбранные" Click="CleanSelectedGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить ВСЁ" Click="CleanAllGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllGameCache_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearGameList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="GameSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="GameSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportGameCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="GameCacheDataGrid" ItemsSource="{Binding GameCacheItems}"
                              MouseDoubleClick="GameCacheDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Очистить выбранные" Click="CleanSelectedGameCache_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Файлов" Binding="{Binding Reason}" Width="100"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Изменён" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding GameCacheSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- НЕИСПОЛЬЗУЕМЫЕ -->
            <TabItem Header="Неиспользуемые файлы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Не использовались более:" Foreground="{StaticResource ThemeMainText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UnusedDaysCombo" Width="120" SelectedIndex="3" Margin="0,0,10,0"
                                  SelectionChanged="UnusedDaysCombo_SelectionChanged">
                            <ComboBoxItem Content="30 дней"/>
                            <ComboBoxItem Content="60 дней"/>
                            <ComboBoxItem Content="90 дней"/>
                            <ComboBoxItem Content="180 дней"/>
                        </ComboBox>
                        <Button Content="Сканировать" Click="ScanUnusedFiles_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="DeleteSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="RecycleSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveSelectedUnused_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearUnusedList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="UnusedSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="UnusedSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UnusedExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="UnusedExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportUnusedCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="UnusedDataGrid" ItemsSource="{Binding UnusedFiles}"
                              MouseDoubleClick="UnusedDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить выбранные" Click="DeleteSelectedUnused_Click"/>
                                <MenuItem Header="В корзину" Click="RecycleSelectedUnused_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveSelectedUnused_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Дата доступа" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Source}" Width="130"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding UnusedSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- АРХИВЫ И УСТАНОВЩИКИ -->
            <TabItem Header="📦 Архивы и установщики">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Не использовались более:" Foreground="{StaticResource ThemeMainText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ArchiveDaysCombo" Width="140" SelectedIndex="3" Margin="0,0,10,0"
                                  SelectionChanged="ArchiveDaysCombo_SelectionChanged">
                            <ComboBoxItem Content="30 дней"/>
                            <ComboBoxItem Content="60 дней"/>
                            <ComboBoxItem Content="90 дней"/>
                            <ComboBoxItem Content="180 дней"/>
                        </ComboBox>
                        <Button Content="Сканировать" Click="ScanArchives_Click" Margin="0,0,10,0"/>
                        <Button Content="В корзину" Click="ArchiveDeleteSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="Архивировать" Click="ArchiveSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllArchives_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearArchiveList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ArchiveSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ArchiveSearch_TextChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Фильтр:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ArchiveExtCombo" Style="{StaticResource FilterComboStyle}"
                                  SelectionChanged="ArchiveExt_SelectionChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportArchiveCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ArchiveDataGrid" ItemsSource="{Binding ArchiveFiles}"
                              MouseDoubleClick="ArchiveDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="В корзину" Click="ArchiveDeleteSelected_Click"/>
                                <MenuItem Header="Архивировать" Click="ArchiveSelected_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="180"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LastAccessTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Source}" Width="120"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding ArchiveSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ДУБЛИКАТЫ -->
            <TabItem Header="Поиск дубликатов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Сканировать:" Foreground="{StaticResource ThemeMainText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DuplicateScopeCombo" Width="220" SelectedIndex="0" Margin="0,0,10,0"
                                  SelectionChanged="DuplicateScopeCombo_SelectionChanged">
                            <ComboBoxItem Content="Папки пользователя (быстро)"/>
                            <ComboBoxItem Content="Весь диск (долго)"/>
                        </ComboBox>
                        <Button Content="Сканировать на дубликаты" Click="ScanDuplicates_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить дубликаты" Click="DeleteDuplicateToRecycleBin_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearDupList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DupSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="DupSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportDupCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="DuplicatesDataGrid" ItemsSource="{Binding DuplicateCandidates}"
                              MouseDoubleClick="DuplicatesDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Удалить дубликаты" Click="DeleteDuplicateToRecycleBin_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTemplateColumn Header="Имя файла" Width="*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="140"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding OriginalPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding DuplicatesSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- АВТОЗАГРУЗКА -->
            <TabItem Header="Автозагрузка">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить список" Click="LoadStartupItems_Click" Margin="0,0,10,0"/>
                        <Button Content="Отключить выбранные" Click="DisableStartupItem_Click" Margin="0,0,10,0"/>
                        <Button Content="Оптимизировать автозагрузку" Click="OptimizeStartup_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearStartupList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StartupSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="StartupSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportStartupCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="StartupDataGrid" ItemsSource="{Binding StartupItems}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Отключить выбранные" Click="DisableStartupItem_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Расположение" Binding="{Binding Location}" Width="160"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="110"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding StartupSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ПРОЦЕССЫ -->
            <TabItem Header="Мониторинг процессов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить процессы" Click="MonitorProcesses_Click" Margin="0,0,10,0"/>
                        <Button Content="Завершить выбранные" Click="KillProcess_Click" Margin="0,0,10,0"/>
                        <CheckBox x:Name="AutoRefreshProcessesCheck"
                                  Content="Авто-обновление"
                                  VerticalAlignment="Center" Margin="10,0,8,0"
                                  Foreground="{StaticResource ThemeMainText}"
                                  Checked="AutoRefreshProcesses_Changed"
                                  Unchecked="AutoRefreshProcesses_Changed"/>
                        <ComboBox x:Name="AutoRefreshIntervalCombo" Width="80" Margin="0,0,10,0"
                                  SelectionChanged="AutoRefreshInterval_Changed">
                            <ComboBoxItem Content="3 сек"/>
                            <ComboBoxItem Content="5 сек"/>
                            <ComboBoxItem Content="10 сек"/>
                            <ComboBoxItem Content="30 сек"/>
                        </ComboBox>
                        <Button Content="Очистить список" Click="ClearProcessList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ProcSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ProcSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportProcCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ProcessesDataGrid" ItemsSource="{Binding RunningProcesses}"
                              MouseDoubleClick="ProcessesDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                                <MenuItem Header="Завершить выбранные" Click="KillProcess_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя процесса" Binding="{Binding ProcessName}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Память" Binding="{Binding MemoryText}" Width="120"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                            <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding ProcessesSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- УДАЛЕНИЕ ПРОГРАММ -->
            <TabItem Header="🗑️ Удаление программ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить список" Click="LoadPrograms_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранные" Click="UninstallPrograms_Click" Margin="0,0,10,0"/>
                        <TextBlock Text="Найдено:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="20,0,6,0"/>
                        <TextBlock x:Name="ProgramsCountText" Text="0"
                                   Foreground="{StaticResource ThemeMainText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button Content="Очистить список" Click="ClearProgramList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ProgramsSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ProgramsSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportProgramsCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ProgramsDataGrid" ItemsSource="{Binding InstalledPrograms}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Удалить" Click="UninstallPrograms_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Версия" Binding="{Binding DisplayVersion}" Width="120"/>
                            <DataGridTextColumn Header="Издатель" Binding="{Binding Publisher}" Width="200"/>
                            <DataGridTextColumn Header="Установлена" Binding="{Binding InstallDate}" Width="120"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                               Text="Выберите программы и нажмите «Удалить выбранные»."
                               Foreground="{StaticResource ThemeSubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ЗАБЛОКИРОВАННЫЕ -->
            <TabItem Header="Заблокированные файлы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить файл..." Click="AddLockedFile_Click" Margin="0,0,10,0"/>
                        <Button Content="Добавить папку..." Click="AddLockedFolder_Click" Margin="0,0,10,0"/>
                        <Button Content="Освободить (завершить процессы)" Click="UnlockSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить в корзину" Click="DeleteLockedFile_Click" Margin="0,0,10,0"/>
                        <Button Content="Выбрать все" Click="SelectAllLocked_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить список" Click="ClearLockedList_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔍 Поиск:" Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="LockedSearchBox" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="LockedSearch_TextChanged" Margin="0,0,12,0"/>
                        <Button Content="📤 Экспорт CSV" Click="ExportLockedCsv_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="LockedDataGrid" ItemsSource="{Binding LockedFiles}"
                              MouseDoubleClick="LockedDataGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" CellTemplate="{StaticResource CheckBoxCellTemplate}" Width="40"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Путь" Binding="{Binding FilePath}" Width="2*"/>
                            <DataGridTextColumn Header="Кто блокирует" Binding="{Binding LockingProcesses}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding LockedSummary.Text}"
                               Foreground="{StaticResource ThemeSubText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ОС И ХАРАКТЕРИСТИКИ -->
            <TabItem Header="ОС и характеристики">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📊 Мониторинг в реальном времени:"
                                   Foreground="{StaticResource ThemeMainText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <CheckBox x:Name="ShowMonitorCheck"
                                  Content="Показывать"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource ThemeMainText}"
                                  Checked="ShowMonitor_Changed"
                                  Unchecked="ShowMonitor_Changed"/>
                        <TextBlock x:Name="CpuRamText"
                                   Foreground="{StaticResource ThemeSubText}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CPU (%)" Foreground="{StaticResource ThemeMainText}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <lvc:CartesianChart Height="180"
                                                    Series="{Binding CpuSeries}"
                                                    XAxes="{Binding CpuXAxes}"
                                                    YAxes="{Binding CpuYAxes}"
                                                    LegendPosition="Hidden"
                                                    TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM (%)" Foreground="{StaticResource ThemeMainText}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <lvc:CartesianChart Height="180"
                                                    Series="{Binding RamSeries}"
                                                    XAxes="{Binding RamXAxes}"
                                                    YAxes="{Binding RamYAxes}"
                                                    LegendPosition="Hidden"
                                                    TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="SystemInfoGrid" ItemsSource="{Binding SystemInfoItems}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ПОМОЩЬ -->
            <TabItem Header="📖 Помощь">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="📖 Как пользоваться Digital Gardener"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}"
                                   Margin="0,0,0,20"/>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="⌨️ Горячие клавиши"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+A" FontWeight="Bold"/><Run Text=" — выбрать все элементы в текущей таблице"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Delete" FontWeight="Bold"/><Run Text=" — удалить выбранное (в корзину)"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="F5" FontWeight="Bold"/><Run Text=" — обновить текущую вкладку"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+E" FontWeight="Bold"/><Run Text=" — экспорт текущей таблицы в CSV"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Escape" FontWeight="Bold"/><Run Text=" — снять выделение"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="● "/><Run Text="Ctrl+S" FontWeight="Bold"/><Run Text=" — открыть настройки"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="♻️ Восстановление удалённых файлов"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="Digital Gardener НЕ удаляет файлы безвозвратно. По умолчанию все удаления идут в "/>
                                    <Run Text="Корзину Windows" FontWeight="Bold"/>
                                    <Run Text=" — вы всегда можете восстановить файл через Проводник (Win+E → Корзина) или кнопкой «Открыть корзину» в шапке приложения."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📦 Архивирование"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap">
                                    <Run Text="Кнопка «Архивировать» перемещает все выбранные файлы в папку "/>
                                    <Run Text="DigitalGardener_Archive" FontWeight="Bold"/>
                                    <Run Text=" рядом с приложением. Оригиналы удаляются со старого места. Файлы НЕ сжимаются — это просто перенос. Если файл занят другой программой (например, Visual Studio держит свои логи), он будет пропущен, а остальные перенесутся."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🖱️ Двойной клик ЛКМ по любой строке — откроет файл или папку в проводнике."
                                   Foreground="{StaticResource ThemeAccent}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="🗑️ Temp и Downloads" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Temp — временная папка Windows. Здесь программы хранят файлы «на минутку» (кэш установки, логи, промежуточные данные) и часто забывают их удалять. Со временем эта папка раздувается до гигабайт. Очистка Temp безопасна: удаляются только мусорные файлы. Скачанные файлы в браузере (Downloads) приложение НЕ трогает."/>

                        <TextBlock Text="🌐 Кэш браузеров" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Когда вы заходите на сайт, браузер сохраняет картинки, скрипты и стили в кэш — чтобы в следующий раз сайт открылся быстрее. Со временем кэш занимает гигабайты. Очистка не затронет ваши пароли, закладки и историю — только временные данные."/>

                        <TextBlock Text="🎮 Игровой кэш" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Игры и видеокарты хранят shader cache — скомпилированные шейдеры для быстрой загрузки уровней. После обновления драйверов или самой игры этот кэш устаревает и занимает место. Очистка безопасна — игры создадут его заново."/>

                        <TextBlock Text="📁 Неиспользуемые файлы" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Приложение ищет файлы, папки и программы, которые вы не открывали дольше выбранного срока (30/60/90/180 дней). Это помогает освободить место. Перед удалением убедитесь, что файл вам действительно не нужен."/>

                        <TextBlock Text="📦 Архивы и установщики" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Приложение ищет «забытые» архивы (.zip, .rar, .7z, .iso и т.д.) и установщики (.exe, .msi), которые не изменялись дольше выбранного срока. Их можно удалить в корзину или перенести в архив приложения. Полезно, когда после распаковки архива или установки программы исходник валяется на диске годами."/>

                        <TextBlock Text="🔍 Поиск дубликатов" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Приложение сравнивает файлы по хешу (уникальному «отпечатку») и находит идентичные копии. Это может освободить много места, если у вас много дубликатов фото, музыки или документов. Можно выбрать область сканирования: папки пользователя (быстро) или весь диск (долго). В любой момент можно нажать «Отмена» — процесс остановится."/>

                        <TextBlock Text="🚀 Автозагрузка" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Программы, которые запускаются с Windows, замедляют старт системы. Приложение показывает всё, что в автозагрузке, и позволяет отключить лишнее. Отключение не удаляет программу — вы всегда можете вернуть её обратно."/>

                        <TextBlock Text="⚙️ Мониторинг процессов" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Показывает все запущенные процессы. Вы можете завершить «зависшие» или ненужные. Системные процессы (например, svchost) завершать не рекомендуется — это может нарушить работу Windows. Можно включить авто-обновление списка с интервалом 3/5/10/30 секунд."/>

                        <TextBlock Text="🗑️ Удаление программ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Список всех установленных программ. При нажатии «Удалить» запускается штатный деинсталлятор программы — тот же, что и в Панели управления Windows. Если программа уже удалена с диска, а запись в реестре осталась, приложение предложит удалить и её."/>

                        <TextBlock Text="🔓 Заблокированные файлы" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Если файл не удаляется («занят другой программой»), приложение подскажет, какая программа держит файл, и поможет её завершить. Это самая полезная функция, если вам нужно срочно удалить занятый файл."/>

                        <TextBlock Text="📊 Графики CPU/RAM" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Показывают загрузку процессора и оперативной памяти в реальном времени. Если графики не нужны — снимите галочку «Показывать» или отключите их в Настройках."/>

                        <TextBlock Text="🔍 Поиск и фильтр" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Над каждой таблицей есть строка поиска и фильтр по расширению файлов. Это позволяет быстро найти нужный файл среди сотен и тысяч строк."/>

                        <TextBlock Text="📋 Журнал и Отчёт" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="На вкладке «Журнал и Отчёт» сверху — журнал всех действий в текущей сессии, снизу — журнал ошибок. Журнал ошибок ведётся отдельно для каждого запуска приложения (файл вида errors_ГГГГ-ММ-ДД_ЧЧ-ММ-СС.log). Новые ошибки появляются в нижнем блоке автоматически. Кнопки «Обновить журнал ошибок» и «Открыть папку логов» позволяют посмотреть историю по предыдущим запускам. Оба журнала можно экспортировать в TXT или CSV."/>

                        <TextBlock Text="💽 Выбор диска" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="В футере приложения (внизу окна) есть выпадающий список дисков. Он влияет на сканирование ТОЛЬКО в трёх вкладках:"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="● "/><Run Text="Неиспользуемые файлы" FontWeight="Bold"/><Run Text=" — ищет старые файлы на выбранном диске"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="● "/><Run Text="Архивы и установщики" FontWeight="Bold"/><Run Text=" — ищет забытые архивы и установщики на выбранном диске"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="● "/><Run Text="Поиск дубликатов" FontWeight="Bold"/><Run Text=" — но ТОЛЬКО в режиме «Весь диск». Если выбран режим «Папки пользователя», сканируются стандартные папки на диске C: (Документы, Изображения, Видео, Загрузки, Рабочий стол)."/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="Остальные вкладки (Temp, Кэш браузеров, Игровой кэш, Автозагрузка, Процессы, Удаление программ, Заблокированные файлы, ОС и характеристики) "/>
                            <Run Text="НЕ зависят от выбора диска" FontWeight="Bold"/>
                            <Run Text=", потому что работают либо с системными папками (Temp, кэш браузеров всегда на C:), либо вообще не с файлами (реестр, процессы)."/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18">
                            <Run Text="Рядом с выпадающим списком показывается "/>
                            <Run Text="свободное место" FontWeight="Bold"/>
                            <Run Text=" на выбранном диске (например: «C: — свободно 27,10 ГБ из 199,49 ГБ»)."/>
                        </TextBlock>

                        <TextBlock Text="⚙️ Настройки" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Кнопка «Настройки» в шапке — позволяет изменить: дни для поиска неиспользуемых файлов, авто-обновление процессов, интервал, показывать ли графики CPU/RAM, сворачивать ли в трей, закрывать ли в трей."/>

                        <TextBlock Text="🛡️ Права администратора" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ThemeMainText}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Приложение требует права администратора при запуске (UAC). Без них некоторые функции будут недоступны: отключение автозагрузки HKLM, завершение системных процессов, удаление системных файлов. Если приложение запущено без прав — в шапке появится красная плашка с кнопкой «Перезапустить от админа»."/>

                        <Border Background="{StaticResource ThemePanelBg}"
                                BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="💬 Связь с разработчиком"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeMainText}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource ThemeSubText}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Нашли баг? Есть идея? Хотите предложить функцию? Пишите в Telegram:"/>
                                <Button Content="✈️ @Boleznen — написать разработчику"
                                        Click="OpenTelegram_Click"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource ThemeAccent}"
                                        Padding="16,8"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="© 2026 Digital Gardener v1.3.0"
                                   Foreground="{StaticResource ThemeSubText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ЖУРНАЛ И ОТЧЁТ -->
            <TabItem Header="Журнал и Отчёт">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📋 Журнал действий:"
                                   Foreground="{StaticResource ThemeMainText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Button Content="Экспорт в TXT" Click="ExportTxt_Click" Margin="0,0,10,0"/>
                        <Button Content="Экспорт в CSV" Click="ExportCsv_Click" Margin="0,0,10,0"/>
                        <Button Content="Открыть папку отчётов" Click="OpenReportsFolder_Click" Margin="0,0,10,0"/>
                        <Button Content="Очистить журнал" Click="ClearReport_Click" Margin="0,0,10,0"/>
                        <Button Content="Удалить файлы отчётов" Click="DeleteAllReports_Click"/>
                    </WrapPanel>

                    <ListBox Grid.Row="1"
                             x:Name="ReportListBox"
                             ItemsSource="{Binding ReportItems}"
                             Background="{StaticResource ThemeItemBg}"
                             Foreground="{StaticResource ThemeMainText}"
                             BorderBrush="{StaticResource ThemeBorder}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="[" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource ThemeSubText}"/>
                                    <TextBlock Text="] [" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="] " Foreground="{StaticResource ThemeAccent}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource ThemeMainText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource ThemeBorder}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="0,8,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ Журнал ошибок:"
                                       Foreground="{StaticResource ThemeWarning}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                            <Button Content="Обновить журнал ошибок" Click="RefreshLog_Click" Margin="0,0,10,0"/>
                            <Button Content="Очистить журнал ошибок" Click="ClearLog_Click" Margin="0,0,10,0"/>
                            <Button Content="Открыть папку логов" Click="OpenLogsFolder_Click" Margin="0,0,10,0"/>
                            <Button Content="Экспорт лога в TXT" Click="ExportLogTxt_Click" Margin="0,0,10,0"/>
                            <Button Content="Экспорт лога в CSV" Click="ExportLogCsv_Click"/>
                        </WrapPanel>
                    </Border>

                    <TextBox Grid.Row="3"
                             x:Name="LogTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource ThemeItemBg}"
                             Foreground="{StaticResource ThemeMainText}"
                             BorderBrush="{StaticResource ThemeBorder}"
                             BorderThickness="1"
                             Padding="8,6"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ФУТЕР -->
        <Border Grid.Row="3" Background="{StaticResource ThemePanelBg}"
                Padding="12" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding ProgressSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ThemeItemBg}"
                                    BorderBrush="{StaticResource ThemeBorder}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="8,4" Margin="0,0,8,0" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{StaticResource ThemeMainText}" FontSize="11"/>
                                    <ProgressBar Height="6" Margin="0,3,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent}"
                                                 Foreground="{StaticResource ThemeGreen}"
                                                 Background="{StaticResource ThemeWindowBg}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="💽 Диск:"
                               Foreground="{StaticResource ThemeSubText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="DriveCombo"
                              Width="280"
                              SelectionChanged="DriveCombo_SelectionChanged"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="Digital Gardener v1.3.0"
                           Foreground="{StaticResource ThemeSubText}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ОВЕРЛЕЙ -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0" Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed"
                Panel.ZIndex="999">
            <Border Background="{StaticResource ThemePanelBg}"
                    BorderBrush="{StaticResource ThemeAccent}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620">
                <StackPanel>
                    <TextBlock Text="⏳"
                               FontSize="42"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="BusyTitle"
                               Text="Подождите, идёт процесс..."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource ThemeMainText}"
                               HorizontalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="BusySubtitle"
                               Text="Не закрывайте программу"
                               FontSize="13"
                               Foreground="{StaticResource ThemeSubText}"
                               HorizontalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,20"/>
                    <ProgressBar x:Name="BusyProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource ThemeGreen}"
                                 Background="{StaticResource ThemeWindowBg}"
                                 BorderThickness="0"
                                 Margin="0,0,0,10"/>
                    <TextBlock x:Name="BusyCounter"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource ThemeSubText}"
                               HorizontalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Width="540"
                               Margin="0,0,0,16"/>

                    <Button x:Name="BusyCancelButton"
                            Content="Отмена"
                            Click="BusyCancel_Click"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Padding="24,8"
                            MinWidth="140"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>